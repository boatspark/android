#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOLS_DIR="$ROOT_DIR/.tools"
DOWNLOADS_DIR="$TOOLS_DIR/downloads"
SDK_DIR="$TOOLS_DIR/android-sdk"
COMMAND_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"

case "$(uname -m)" in
    aarch64)
        JDK_URL="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_aarch64_linux_hotspot_21.0.12.1_1.tar.gz"
        ;;
    x86_64)
        JDK_URL="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_x64_linux_hotspot_21.0.12.1_1.tar.gz"
        ;;
    *)
        echo "Unsupported Linux architecture: $(uname -m)" >&2
        exit 1
        ;;
esac

mkdir -p "$DOWNLOADS_DIR"

if [[ ! -x "$TOOLS_DIR/jdk/bin/java" ]]; then
    curl -fL --retry 3 "$JDK_URL" -o "$DOWNLOADS_DIR/jdk.tar.gz"
    mkdir -p "$TOOLS_DIR/jdk"
    tar -xzf "$DOWNLOADS_DIR/jdk.tar.gz" -C "$TOOLS_DIR/jdk" --strip-components=1
fi

if [[ ! -x "$SDK_DIR/cmdline-tools/legacy/bin/sdkmanager" ]]; then
    curl -fL --retry 3 "$COMMAND_TOOLS_URL" -o "$DOWNLOADS_DIR/commandlinetools.zip"
    rm -rf "$TOOLS_DIR/cmdline-stage"
    mkdir -p "$TOOLS_DIR/cmdline-stage" "$SDK_DIR/cmdline-tools/legacy"
    unzip -q -o "$DOWNLOADS_DIR/commandlinetools.zip" -d "$TOOLS_DIR/cmdline-stage"
    cp -a "$TOOLS_DIR/cmdline-stage/cmdline-tools/." "$SDK_DIR/cmdline-tools/legacy/"
fi

export JAVA_HOME="$TOOLS_DIR/jdk"
export ANDROID_HOME="$SDK_DIR"
export ANDROID_SDK_ROOT="$SDK_DIR"
yes | "$SDK_DIR/cmdline-tools/legacy/bin/sdkmanager" --licenses >/dev/null
"$SDK_DIR/cmdline-tools/legacy/bin/sdkmanager" \
    "platforms;android-36" \
    "build-tools;36.0.0" \
    "platform-tools"

if [[ "$(uname -m)" == "aarch64" ]]; then
    PACKAGES_DIR="$TOOLS_DIR/debian-packages"
    mkdir -p "$PACKAGES_DIR"
    (
        cd "$PACKAGES_DIR"
        apt download qemu-user
    )
    mkdir -p "$TOOLS_DIR/qemu"
    dpkg-deb -x "$PACKAGES_DIR"/qemu-user_*.deb "$TOOLS_DIR/qemu"

    mkdir -p \
        "$TOOLS_DIR/apt-amd64/lists/partial" \
        "$TOOLS_DIR/apt-amd64/cache/archives/partial"
    apt-get \
        -o APT::Architecture=amd64 \
        -o APT::Architectures=amd64 \
        -o Dir::State::Lists="$TOOLS_DIR/apt-amd64/lists" \
        -o Dir::Cache="$TOOLS_DIR/apt-amd64/cache" \
        update -qq
    (
        cd "$PACKAGES_DIR"
        apt-get \
            -o APT::Architecture=amd64 \
            -o APT::Architectures=amd64 \
            -o Dir::State::Lists="$TOOLS_DIR/apt-amd64/lists" \
            -o Dir::Cache="$TOOLS_DIR/apt-amd64/cache" \
            download libc6 libstdc++6 libgcc-s1 zlib1g
    )
    mkdir -p "$TOOLS_DIR/x86-root"
    for package in "$PACKAGES_DIR"/*_amd64.deb; do
        dpkg-deb -x "$package" "$TOOLS_DIR/x86-root"
    done
    mkdir -p "$TOOLS_DIR/x86-root/lib64"
    ln -sf ../usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 \
        "$TOOLS_DIR/x86-root/lib64/ld-linux-x86-64.so.2"
    cc -O2 "$ROOT_DIR/scripts/aapt2-launcher.c" -o "$TOOLS_DIR/aapt2"
fi

cp -n "$ROOT_DIR/local.properties.example" "$ROOT_DIR/local.properties" || true
echo "Local BoatSpark toolchain is ready."
