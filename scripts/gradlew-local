#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/scripts/env.sh"
if [[ -n "${BOATSPARK_AAPT2_OVERRIDE:-}" ]]; then
    exec "$ROOT_DIR/gradlew" \
        "-Pandroid.aapt2FromMavenOverride=$BOATSPARK_AAPT2_OVERRIDE" \
        "$@"
fi
exec "$ROOT_DIR/gradlew" "$@"
